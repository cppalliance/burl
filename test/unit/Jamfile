import testing ;
import ac ;

project
    : requirements
      $(c20-requires)
      <library>/boost/burl//boost_burl
      [ ac.check-library /boost/http//boost_http_zlib : <library>/boost/http//boost_http_zlib : ]
      [ ac.check-library /boost/http//boost_http_brotli : <library>/boost/http//boost_http_brotli : ]
      [ ac.check-library /boost/http//boost_http_zstd : <library>/boost/http//boost_http_zstd : ]
      <source>../../../capy/extra/test_suite/test_main.cpp
      <source>../../../capy/extra/test_suite/test_suite.cpp
      <include>.
      <include>../..
      <include>../../../capy/extra/test_suite
      <warnings>extra
      # <warnings-as-errors>on
      <undefined-sanitizer>norecover:<link>static
      # TODO: detail tests reach internal (non-exported) symbols, which forces
      # static linking for the whole target. Rework so this isn't required.
      <link>static
    ;

for local f in [ glob *.cpp ]
{
    run $(f) ;
}
